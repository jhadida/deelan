---
interface Props {
  idPrefix: string;
  ariaLabel?: string;
  queryPlaceholder?: string;
}

const {
  idPrefix,
  ariaLabel = 'Search',
  queryPlaceholder = 'tag:x  title:"foo bar"  id:x  from:date  to:date  &  |  ()'
} = Astro.props;
---

<section class="search-shell" aria-label={ariaLabel}>
  <div class="panel section-block search-panel">
    <input
      id={`${idPrefix}-query`}
      class="search-query-input"
      type="search"
      placeholder={queryPlaceholder}
      autocomplete="off"
      spellcheck="false"
    />
    <button
      id={`${idPrefix}-search-trigger`}
      class="search-trigger-btn"
      type="button"
      aria-label="Apply search query"
      title="Apply search query"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <line x1="15.5" y1="15.5" x2="21" y2="21"></line>
      </svg>
    </button>
  </div>
</section>
